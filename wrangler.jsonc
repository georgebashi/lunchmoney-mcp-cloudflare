{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lunchmoney-mcp",
    "main": "src/worker.ts",
    "compatibility_date": "2025-03-10",
    "compatibility_flags": ["nodejs_compat"],
    "kv_namespaces": [
        {
            // OAuth client registrations, grants and issued tokens.
            //   npx wrangler kv namespace create OAUTH_KV
            "binding": "OAUTH_KV",
            "id": "REPLACE_WITH_OAUTH_KV_ID"
        }
    ],
    "ratelimits": [
        {
            // Per-IP limit on POST /register. DCR has to stay open, so this is
            // what stops a passer-by filling OAUTH_KV with registrations.
            "name": "REGISTER_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 2, "period": 60 }
        },
        {
            // Per-IP limit on POST /authorize — the only place the API token
            // can be guessed at. Five a minute leaves room for a typo and
            // nothing more.
            "name": "LOGIN_LIMITER",
            "namespace_id": "1002",
            "simple": { "limit": 5, "period": 60 }
        }
    ],
    "observability": {
        "enabled": true
    }
}
