{
    "name": "lunchmoney-mcp-cloudflare",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "description": "Cloudflare Worker that exposes the LunchMoney MCP server (akutishevsky/lunchmoney-mcp) as a personal remote MCP endpoint for Claude.",
    "scripts": {
        "setup": "bash setup.sh",
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "cf-typegen": "wrangler types",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@akutishevsky/lunchmoney-mcp": "github:georgebashi/lunchmoney-mcp#a12411ea4d45da721397b1d85d21202a0a5f5748",
        "@cloudflare/workers-oauth-provider": "0.8.3",
        "@modelcontextprotocol/server": "2.0.0",
        "agents": "0.22.0",
        "zod": "^4.6.1"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "0.22.0",
        "@cloudflare/workers-types": "5.20260910.1",
        "@eslint/js": "10.0.1",
        "eslint": "10.10.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0",
        "vitest": "4.1.11",
        "wrangler": "4.130.0"
    },
    "overrides": {
        "agents": "$agents",
        "@modelcontextprotocol/server": "$@modelcontextprotocol/server"
    }
}
