# Local development secret. Copy to .dev.vars (gitignored) before running
# `wrangler dev`. In production set it with:
#   npx wrangler secret put LUNCHMONEY_API_TOKEN

# Your personal LunchMoney API token, from
# https://my.lunchmoney.app/developers. The worker calls LunchMoney with it,
# and pasting it at /authorize is how you approve a connector.
LUNCHMONEY_API_TOKEN=
